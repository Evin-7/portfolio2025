# Required in Vercel before enabling visitor notifications.
VISITOR_NOTIFICATIONS_ENABLED=true
VISITOR_NOTIFICATION_MODE=daily
VISITOR_CONSENT_SECRET=replace-with-at-least-32-random-characters
VISITOR_HASH_SECRET=replace-with-a-different-32-character-random-secret
CRON_SECRET=replace-with-a-long-random-cron-secret
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-upstash-rest-token

# Use the existing EmailJS service and public key already configured for the contact form.
# Keep the EmailJS private key server-only. Never prefix it with NEXT_PUBLIC_.
EMAILJS_PRIVATE_KEY=your-emailjs-private-key
# Use a separate EmailJS template so visitor alerts don't change the contact form.
# Set its recipient to the existing notification address, subject to {{subject}}, and body to {{message}}.
EMAILJS_VISITOR_TEMPLATE_ID=your-visitor-template-id

# Optional override. Leave unset to use Vercel's canonical production URL.
VISITOR_EMAIL_ORIGIN=

# Local-only workflow test switch. Do not enable in production.
VISITOR_NOTIFICATIONS_TEST_MODE=false
